{
  "name": "@chatprd/icons",
  "version": "1.0.1",
  "description": "ChatPRD line icons and spot icons as tree-shakeable React components and raw SVGs.",
  "private": false,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChatPRD/chatprd-icons.git"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./spots/*": {
      "types": "./dist/spots/*.d.ts",
      "import": "./dist/spots/*.js"
    },
    "./animated": {
      "types": "./dist/animated.d.ts",
      "import": "./dist/animated.js"
    },
    "./svg/*": "./svg/*",
    "./color/*": "./color/*",
    "./color-small/*": "./color-small/*",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "svg",
    "color",
    "color-small",
    "manifest.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "icons": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs && rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node --test test/render.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "prepublishOnly": "npm run check && npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
